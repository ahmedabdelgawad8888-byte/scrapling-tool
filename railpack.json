{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "packages": {
    "python": "3.12"
  },
  "deploy": {
    "startCommand": "uvicorn webapp.server:create_app --factory --host 0.0.0.0 --port ${PORT:-8000} --workers 1",
    "variables": {
      "PYTHONUNBUFFERED": "1",
      "PYTHONDONTWRITEBYTECODE": "1"
    }
  }
}
