# Slim image for hosts with ~512MB RAM (Render's free tier and similar).
#
# Deliberately ships NO Chromium: the browser alone needs more memory than the
# whole instance has, so installing it would only buy OOM kills. The app probes
# for a browser at startup, reports `browser: false`, and disables the Browser
# and Stealth modes in the UI rather than offering something that cannot run.
#
# HTTP mode still covers YouTube, X/Twitter and Instagram. TikTok answers
# plain-HTTP clients with a captcha shell, so it reports as Blocked here.
# For full coverage use the main ./Dockerfile on a host with ~2GB.

FROM python:3.12-slim

LABEL org.opencontainers.image.title="scrapling-tool" \
      org.opencontainers.image.description="Scrapling scraping dashboard (HTTP-only build)" \
      org.opencontainers.image.licenses="BSD-3-Clause"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PORT=10000

WORKDIR /app

COPY requirements.txt ./
RUN pip install --upgrade pip && \
    pip install -r requirements.txt

COPY . .

RUN useradd -m -u 1000 user && chown -R user:user /app
USER user
ENV HOME=/home/user

EXPOSE 10000

# Shell form so ${PORT} is read at runtime — Render assigns it.
CMD uvicorn webapp.server:create_app --factory --host 0.0.0.0 --port ${PORT:-10000} --workers 1
