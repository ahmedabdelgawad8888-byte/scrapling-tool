# Scrapling Tool — environment configuration
#
# Copy to `.env` and fill in. `.env` is gitignored; this file must never
# contain a real credential.

# --------------------------------------------------------------------------
# Access control
# --------------------------------------------------------------------------
# Password gate for the dashboard. Leave unset ONLY when the port is bound to
# 127.0.0.1 and never tunnelled. Any public URL without this hands over full
# scraper control to anyone who finds it.
SCRAPLING_PASSWORD=

# Host/port for the local server.
SCRAPLING_HOST=127.0.0.1
SCRAPLING_PORT=8080

# --------------------------------------------------------------------------
# Search & extraction providers (all optional — the tool degrades gracefully)
# --------------------------------------------------------------------------
# Keys can also be set from the Providers page in the dashboard, which stores
# them in the app database instead of here.
TAVILY_API_KEY=
SERPER_API_KEY=
SERPAPI_API_KEY=
SCRAPEGRAPH_API_KEY=
SCRAPERAPI_KEY=
SCRAPINGBEE_API_KEY=

# --------------------------------------------------------------------------
# Networking
# --------------------------------------------------------------------------
# Default proxy applied when a run does not specify one.
# Format: http://user:pass@host:port
SCRAPLING_PROXY=

# Comma-separated proxy pool seeded into the Proxies page on first boot.
SCRAPLING_PROXY_POOL=

# Global politeness ceiling — max requests per second per domain.
SCRAPLING_RATE_LIMIT=2.0

# --------------------------------------------------------------------------
# Storage
# --------------------------------------------------------------------------
# Where the SQLite databases live. Defaults to the project directory.
SCRAPLING_DATA_DIR=

# Set to use Postgres for run history instead of SQLite.
SUPABASE_DB_URL=
